<Window
    x:Class="VolumeLock.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VolumeLock">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (doubles as the title bar drag region) -->
        <StackPanel x:Name="TitleBarArea" Grid.Row="0" Padding="24,12,24,10" Spacing="8" Orientation="Horizontal">
            <Image x:Name="AppIconImage" Width="20" Height="20" VerticalAlignment="Center" />
            <TextBlock Text="VolumeLock" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            Margin="24,6,24,0"
            IsClosable="True"
            IsOpen="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,12,0,0">
            <StackPanel Padding="24,0,24,32" Spacing="16">

                <!-- System Sounds -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE995;"
                                FontSize="20"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="System Sounds" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="SystemSoundsDeviceNameText"
                                    Text="Default playback device"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="SystemSoundsSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="SystemSoundsSlider_ValueChanged" />
                            <NumberBox
                                x:Name="SystemSoundsNumberBox"
                                Grid.Column="1"
                                Width="64"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                AcceptsExpression="False"
                                SpinButtonPlacementMode="Hidden"
                                VerticalAlignment="Center"
                                ValueChanged="SystemSoundsNumberBox_ValueChanged" />
                            <Button
                                x:Name="SystemSoundsLockButton"
                                Grid.Column="2"
                                Width="40"
                                Height="32"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="SystemSoundsLockButton_Click">
                                <FontIcon x:Name="SystemSoundsLockIcon" Glyph="&#xE785;" FontSize="16" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Microphone -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE720;"
                                FontSize="20"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Microphone" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="MicrophoneDeviceNameText"
                                    Text="Default input device"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="MicrophoneSlider"
                                Grid.Column="0"
                                Minimum="0"
                                Maximum="100"
                                StepFrequency="1"
                                VerticalAlignment="Center"
                                ValueChanged="MicrophoneSlider_ValueChanged" />
                            <NumberBox
                                x:Name="MicrophoneNumberBox"
                                Grid.Column="1"
                                Width="64"
                                Minimum="0"
                                Maximum="100"
                                SmallChange="1"
                                AcceptsExpression="False"
                                SpinButtonPlacementMode="Hidden"
                                VerticalAlignment="Center"
                                ValueChanged="MicrophoneNumberBox_ValueChanged" />
                            <Button
                                x:Name="MicrophoneLockButton"
                                Grid.Column="2"
                                Width="40"
                                Height="32"
                                MinWidth="0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="MicrophoneLockButton_Click">
                                <FontIcon x:Name="MicrophoneLockIcon" Glyph="&#xE785;" FontSize="16" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="General" FontSize="15" FontWeight="SemiBold" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleSwitch
                                x:Name="RunAtStartupToggle"
                                Grid.Column="0"
                                Header="Run at startup"
                                OnContent=""
                                OffContent=""
                                Toggled="RunAtStartupToggle_Toggled" />
                            <ToggleSwitch
                                x:Name="HideTrayIconToggle"
                                Grid.Column="1"
                                Header="Hide tray icon"
                                OnContent=""
                                OffContent=""
                                Toggled="HideTrayIconToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
